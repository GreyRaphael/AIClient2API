{
  "name": "aiclient2api",
  "version": "8.9.2",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "google-auth-library": "^11.3.4",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@preact/signals": "2.11.4",
    "@preact/signals-core": "1.14.5",
    "@types/node": "^26.6.6",
    "htm": "3.1.1",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.2",
    "stylelint": "^18.0.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "node src/core/master.js",
    "start:standalone": "node src/services/api-server.js",
    "start:dev": "node src/core/master.js --dev",
    "test": "node --experimental-test-module-mocks --import ./tests/support/register-ui-alias.mjs --test --test-concurrency=${TEST_CONCURRENCY:-5} 'tests/*.test.mjs' 'tests/regressions/*.test.mjs'",
    "test:verbose": "node --experimental-test-module-mocks --import ./tests/support/register-ui-alias.mjs --test --test-concurrency=${TEST_CONCURRENCY:-5} --test-reporter=spec 'tests/*.test.mjs' 'tests/regressions/*.test.mjs'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "check:imports": "node scripts/check-imports.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "test:runtime": "node scripts/smoke-runtime.mjs",
    "metrics:types": "node scripts/type-metrics.mjs",
    "metrics:strict": "node scripts/strict-metrics.mjs",
    "check:strict": "node scripts/strict-metrics.mjs --check",
    "verify": "npm run typecheck && npm run typecheck:webui && npm run check:strict && npm run check:any && npm run check:imports && npm run check:cycles && npm run lint:css && npm run gen:webui-html:check && npm run vendor:webui:check && npm test && npm run test:runtime",
    "help": "node src/scripts/help.ts",
    "example:api": "node src/scripts/example-api.ts",
    "login:zed": "node src/scripts/login-zed.ts",
    "login:trae": "node src/scripts/login-trae.ts",
    "benchmark:concurrent": "node src/scripts/concurrent-test.ts",
    "benchmark:cache": "node scripts/cache-hit-benchmark.mjs",
    "check:any": "node scripts/type-metrics.mjs --check",
    "vendor:webui": "node scripts/sync-webui-vendor.mjs",
    "vendor:webui:check": "node scripts/sync-webui-vendor.mjs --check",
    "gen:webui-html": "node scripts/gen-webui-html-head.mjs",
    "gen:webui-html:check": "node scripts/gen-webui-html-head.mjs --check",
    "vendor:fa": "node scripts/subset-fontawesome.mjs",
    "typecheck:webui": "tsc -p tsconfig.webui.json --noEmit",
    "lint:css": "stylelint \"static/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"static/**/*.css\"",
    "test:e2e": "node --experimental-test-module-mocks --import ./tests/support/register-ui-alias.mjs --import ./tests/e2e/global-setup.js --test --test-timeout=300000 'tests/e2e/*.e2e.test.mjs'",
    "test:e2e:providers": "node --experimental-test-module-mocks --import ./tests/support/register-ui-alias.mjs --import ./tests/e2e/global-setup.js --test --test-timeout=300000 'tests/e2e/providers/*.e2e.test.mjs'",
    "test:e2e:images": "node --experimental-test-module-mocks --import ./tests/support/register-ui-alias.mjs --import ./tests/e2e/global-setup.js --test --test-timeout=300000 tests/e2e/image-input.e2e.test.mjs",
    "test:e2e:images:generation": "node --experimental-test-module-mocks --import ./tests/support/register-ui-alias.mjs --import ./tests/e2e/global-setup.js --test --test-timeout=300000 tests/e2e/image-generation.e2e.test.mjs",
    "test:webui:e2e": "playwright test -c tests/webui-e2e/playwright.config.js",
    "test:e2e:matrix": "node --experimental-test-module-mocks --import ./tests/support/register-ui-alias.mjs --import ./tests/e2e/global-setup.js --test --test-timeout=300000 tests/e2e/matrix.e2e.test.mjs"
  }
}
