{
  "name": "aiclient2api",
  "version": "5.2.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "adm-zip": "^0.5.16",
    "axios": "^1.14.0",
    "busboy": "^1.6.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.6.1",
    "google-auth-library": "^10.1.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "multer": "^2.0.2",
    "open": "^10.2.0",
    "socks-proxy-agent": "^8.0.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.29.7",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "1.64.1",
    "@preact/signals": "2.11.4",
    "@preact/signals-core": "1.14.5",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.20.5",
    "babel-jest": "^30.0.5",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "htm": "3.1.1",
    "jest": "^29.7.0",
    "preact": "11.1.0",
    "preact-render-to-string": "6.8.2",
    "subset-font": "2.9.0",
    "typescript": "^5.9.3",
    "undici": "^7.12.0"
  },
  "scripts": {
    "start": "node src/core/master.js",
    "start:standalone": "node src/services/api-server.js",
    "start:dev": "node src/core/master.js --dev",
    "test": "jest",
    "test:integration": "jest tests/api-integration.test.js --forceExit --testPathIgnorePatterns=''",
    "test:e2e": "jest tests/e2e --runInBand --forceExit --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=/tests/e2e/providers/ --testPathIgnorePatterns=/tests/e2e/image-generation/ --testTimeout=300000 --globalSetup=./tests/e2e/global-setup.js",
    "test:e2e:providers": "jest tests/e2e/providers --runInBand --forceExit --testPathIgnorePatterns=/node_modules/ --testTimeout=300000 --globalSetup=./tests/e2e/global-setup.js",
    "test:e2e:images": "jest tests/e2e/image-input.e2e.test.js --runInBand --forceExit --testPathIgnorePatterns=/node_modules/ --testTimeout=300000 --globalSetup=./tests/e2e/global-setup.js",
    "test:e2e:images:generation": "jest tests/e2e/image-generation.e2e.test.js --runInBand --forceExit --testPathIgnorePatterns=/node_modules/ --testTimeout=300000 --globalSetup=./tests/e2e/global-setup.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:silent": "jest --silent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:plugins": "tsc -p tsconfig.plugins.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "check:imports": "node scripts/check-imports.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "coverage:update": "node scripts/check-coverage.mjs --update",
    "test:runtime": "node scripts/smoke-runtime.mjs",
    "metrics:types": "node scripts/type-metrics.mjs",
    "metrics:strict": "node scripts/strict-metrics.mjs",
    "check:strict": "node scripts/strict-metrics.mjs --check",
    "verify": "npm run typecheck && npm run typecheck:plugins && npm run check:strict && npm run check:any && npm run check:imports && npm run check:cycles && npm run test:coverage -- --runInBand && npm run check:coverage && npm run test:runtime",
    "help": "node src/scripts/help.ts",
    "example:api": "node src/scripts/example-api.ts",
    "login:zed": "node src/scripts/login-zed.ts",
    "login:trae": "node src/scripts/login-trae.ts",
    "benchmark:concurrent": "node src/scripts/concurrent-test.ts",
    "check:any": "node scripts/type-metrics.mjs --check",
    "vendor:webui": "node scripts/sync-webui-vendor.mjs",
    "vendor:webui:check": "node scripts/sync-webui-vendor.mjs --check",
    "vendor:fa": "node scripts/subset-fontawesome.mjs",
    "typecheck:webui": "tsc -p tsconfig.webui.json --noEmit",
    "test:webui:e2e": "playwright test -c tests/webui-e2e/playwright.config.js"
  }
}
