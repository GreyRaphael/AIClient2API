{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    // 浏览器不做扩展名补全，且 .ts 由服务端运行时擦除后直出，
    // 因此 static/ui 下的相对 import 必须写完整扩展名（.js 或 .ts）。
    "allowImportingTsExtensions": true
  },
  "include": ["static/ui/**/*.js", "static/ui/**/*.ts"]
}
