{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    // 以下两项为增量收紧（strict 仍未整体打开）：
    // - strictNullChecks：null/undefined 参与类型系统。打开时仅 17 处需修，成本低于预期，
    //   且能挡住「可选字段当成必有」这类线上最常见的崩溃来源。
    // - noImplicitOverride：覆写必须显式标注。打开时 64 处（56 处在 adapter.ts），
    //   顺带把「到底哪些方法真在覆写」变成可 grep 的事实。
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "lib": ["ES2024", "ESNext"]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "types/**/*.d.ts",
    "types/**/*.ts"
  ]
}
