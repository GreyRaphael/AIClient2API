{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // strict 已整体开启（原 strictNullChecks / noImplicitOverride / noUnusedLocals / noUnusedParameters 已涵盖于 strict 并额外保留后三项）
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "lib": ["ES2024", "ESNext"]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "types/**/*.d.ts",
    "types/**/*.ts"
  ]
}
